{
  "name": "absensi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @absensi/web",
    "dev:api": "npm run dev -w @absensi/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "bench": "vitest run --project api apps/api/src/test/spike.measure.test.ts --reporter=verbose",
    "build": "npm run build -w @absensi/web && npm run build -w @absensi/api",
    "db:migrate:local": "npm run db:migrate:local -w @absensi/api",
    "db:migrate:remote": "npm run db:migrate:remote -w @absensi/api",
    "db:reset:local": "npm run db:reset:local -w @absensi/api"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261023.1": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
