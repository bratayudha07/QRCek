{
  // Test-only Wrangler config.
  //
  // Differences from wrangler.jsonc:
  //   - no `assets`: tests exercise /api/* only, and the SPA build output does
  //     not exist yet when CI runs `npm run test` (build runs afterwards).
  //   - `main` is the same module under test.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "absensi-api-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  // Test-only pepper. Never reuse this value outside `vitest`.
  "vars": {
    "SESSION_PEPPER": "test-only-pepper-0123456789abcdef",
    "QR_PEPPER": "test-only-qr-pepper-0123456789abcdef",
    "QR_ENCRYPTION_KEY": "MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=",
    "QR_KEY_VERSION": "1",
    "ALLOWED_ORIGINS": "https://absensi.test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "absensi-db-test",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "migrations_dir": "../../migrations"
    }
  ]
}
