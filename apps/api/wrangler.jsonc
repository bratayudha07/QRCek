{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qrcek",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "absensi-db",
      "database_id": "5c8ec1c4-c1ef-4058-80bc-1d114929c669",
      "migrations_dir": "../../migrations"
    }
  ]
}